rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Products collection: Customers can read, Admin can create, update, delete
    match /products/{productId} {
      allow read: if true;
      allow write, create, update, delete: if true;
    }

    // Hero slides: Customers can read, Admin can manage
    match /heroSlides/{slideId} {
      allow read: if true;
      allow write, create, update, delete: if true;
    }

    // Store branding and settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Customer purchase orders: Customers can create orders, Admin can view/manage
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Admins collection
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // General fallback
    match /{document=**} {
      allow read: if true;
      allow write: if true;
    }
  }
}

